{
  "name": "@brilliant-guitar/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "kernel:build": "node scripts/prepare-kernel.mjs",
    "predev": "npm run kernel:build",
    "prebuild": "npm run kernel:build",
    "pretypecheck": "npm run kernel:build",
    "test": "npm run kernel:build && tsc --noEmit -p tsconfig.test.json && node --experimental-strip-types --test test/*.test.ts",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-menubar": "1.1.24",
    "@tauri-apps/api": "^2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vexflow": "5.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
