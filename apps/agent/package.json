{
  "name": "@brilliant-guitar/standalone-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "runtime:build": "node scripts/prepare-runtime.mjs",
    "predev": "npm run runtime:build",
    "dev": "node --experimental-strip-types src/server/main.ts --dev",
    "prebuild": "npm run runtime:build",
    "build": "tsc -p tsconfig.server.json && vite build",
    "pretypecheck": "npm run runtime:build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.json",
    "pretest": "npm run runtime:build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "start": "node dist/server/main.js",
    "smoke:fake": "node --experimental-strip-types test/smoke-fake.ts"
  },
  "dependencies": {
    "@brilliant-guitar/agent-runtime": "file:../../packages/agent-runtime",
    "@earendil-works/pi-ai": "1.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
