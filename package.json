{
  "name": "brilliant-guitar",
  "version": "0.1.0",
  "private": true,
  "description": "Brilliant Guitar Rust microkernel, React workbench, and Tauri desktop product.",
  "scripts": {
    "ui:dev": "npm --prefix apps/workbench run dev",
    "ui:build": "npm --prefix apps/workbench run build",
    "ui:typecheck": "npm --prefix apps/workbench run typecheck",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:package": "npm --prefix apps/desktop run package",
    "desktop:check": "npm --prefix apps/desktop run check",
    "desktop:test": "npm --prefix apps/desktop run test",
    "desktop:info": "npm --prefix apps/desktop run info",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/test/test-infrastructure/run-compiled-tests.js",
    "test:kernel-commercial": "npm run build && node scripts/qualify-integrated-addon.mjs",
    "test:cvn7": "npm run build && node --test \"dist/test/core-kernel/cvn-7-*.test.js\"",
    "qualify:cvn7": "node --expose-gc dist/test/core-kernel/qualification/cvn-7-runner.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
