{
  "name": "brilliant-guitar",
  "version": "0.1.0",
  "private": true,
  "description": "Brilliant Guitar TypeScript kernel and private Rust native runtime.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node dist/test/test-infrastructure/run-compiled-tests.js",
    "test:cvn7": "npm run build && node --test \"dist/test/core-kernel/cvn-7-*.test.js\"",
    "qualify:cvn7": "node --expose-gc dist/test/core-kernel/qualification/cvn-7-runner.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
